@version("0.2.0")

# Demonstrates author-defined components: props, state, slots, events, dual surfaces.

class CounterCard is component {
    has Str $.title = "Counter";
    has state Int $.count = 0;
    emit changed;

    slot actions;

    method render() {
        ui::card(
            ui::heading(:text($.title), :level(3)),
            ui::text(:text($.count)),
            ui::row(
                ui::button(:label("−"), :on(click(decrement))),
                ui::button(:label("+"), :variant(primary), :on(click(increment)))
            )
        )
    }

    method increment() {
        $.count = $.count + 1;
        emit changed;
    }

    method decrement() {
        $.count = $.count - 1;
        emit changed;
    }
}

class ComponentsPage is component {
    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("Components"))),
            :side_panel(ui::side_panel(
                ui::nav_item(:label("Demo"), :to("/"), :active)
            )),
            ui::stack(
                ui::heading(:text("Author-defined components"), :level(1)),
                ui::text(:text("Props, local state, and events — on web and terminal.")),
                CounterCard(:title("Clicks"))
            )
        )
    }
}

class ComponentsApp is app {
    route "/" => ComponentsPage;

    method serve() {
        ui::web(:root(ComponentsApp), :port(18100), :route("/"))
            ==> ui::terminal(:port(18101))
    }
}

#!/usr/bin/env silc
# Raku-inspired Silc surface — see docs/ADR-002-silc-surface-syntax.md
@version("1.0")

subset Uri of Str where { .contains("://") }
subset Emb768 of Vec[num32; 768];

class ArticlePayload {
    has UUID $.id;
    has Uri $.url;
    has Str $.raw_content;
    has Emb768 $.vector_embedding;
}

class NetworkIngress is service {
    method fetch_article(
        Uri $target_url,
        :$timeout = 1500ms,
        :$concurrency = 5000
    ) {
        $target_url
            ==> http::get()
            ==> html::extract_body()
            ==> ArticlePayload
    }
}

class EmbeddingEngine is processor {
    has Str $.model_ref = "sentence-transformers/all-mpnet-base-v2";

    method generate_vectors(ArticlePayload $payload) {
        $payload.raw_content
            ==> tensor::tokenize()
            ==> tensor::infer(:model($.model_ref), :batch(64), :prefer<CUDA>)
            ==> payload::attach_vector($payload)
    }
}

class RealtimeCache is sink is latency(2ms) is storage(MemoryMapped) {
    method persist(ArticlePayload $payload) {
        $payload
            ==> ipc::share_buffer()
            ==> store::upsert_primary()
    }
}

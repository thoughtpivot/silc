#!/usr/bin/env silc
# AI Chatbot #2: declarative chat view — conversation on the left,
# chat history on the right. Turns persist to SQLite through Go.
@version("1.0")

subset NonEmpty of Str where { .chars > 0 }

class ChatTurn {
    has UUID $.id;
    has NonEmpty $.prompt;
    has Str $.reply;
    has Str $.model;
}

class ChatbotView is view {
    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("AI Chatbot #2"))),
            ui::row(
                ui::chat(
                    :field(prompt),
                    :label("Message"),
                    :placeholder("Ask the local model anything…")
                ),
                ui::chat_history(:title("Chat History"), :collapsible)
            )
        )
    }
}

class ChatPortal is service {
    method listen(:$port = 18091) {
        ChatTurn
            ==> ui::web(:view(ChatbotView), :port(18091), :route("/"))
    }
}

class LocalLlm is processor {
    has Str $.model_ref = "llama3.2-1b";

    method complete(ChatTurn $turn) {
        $turn.prompt
            ==> llm::complete(:model($.model_ref))
    }
}

class ChatLog is sink is storage(SQLite) {
    method persist(ChatTurn $turn) {
        $turn
            ==> ipc::publish()
            ==> store::sqlite(:table(chat_turns))
            ==> store::commit()
    }
}

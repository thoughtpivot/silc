#!/usr/bin/env silc
# Native Silc 0.4.0 AI chat assistant with multiple chats.
@version("0.4.0")

contract ChatSession {
    has Str $.id;
    has Str $.title;
}

contract ChatRecord {
    has Str $.prompt;
    has Str $.reply;
    has Str $.session_id;
}

resource ChatSessions for ChatSession {
    query list;
    mutation create;
    mutation update;
    mutation delete;
}

component SessionItem {
    has ChatSession $.session;
    has Bool $.selected = false;
    has Str $.draft_title = "";
    emit select(ChatSession);

    method render() {
        ui::stack(
            when $.selected {
                ui::button(
                    :label($.draft_title),
                    :variant("primary"),
                    :on(click(on_click))
                )
            } else {
                ui::button(
                    :label($.session.title),
                    :variant("secondary"),
                    :on(click(on_click))
                )
            }
        )
    }

    method on_click() {
        emit select($.session);
    }
}

component ChatPage {
    has state Str $.prompt = "";
    has state Str $.active_session = "";
    has state Str $.title_edit = "New conversation";
    query $.sessions = ChatSessions.list();

    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("AI Chat Assistant"))),
            :side_panel(ui::side_panel(
                ui::stack(
                    ui::button(
                        :label("+ New chat"),
                        :on(click(on_new))
                    ),
                    ui::heading(:text("Chats"), :level(3)),
                    for $.sessions -> $session {
                        SessionItem(
                            :session($session),
                            :selected($.active_session == $session.id),
                            :draft_title($.title_edit),
                            :on(select => on_select)
                        )
                    }
                )
            )),
            ui::stack(
                when $.active_session {
                    ui::section(
                        :title($.title_edit),
                        :description("Rename this conversation or continue chatting with silclm."),
                        ui::form(:on(submit(on_rename)),
                            ui::text_input(:field(title_edit), :label("Rename chat")),
                            ui::toolbar(
                                ui::button(:label("Save name"), :submit),
                                ui::button(
                                    :label("Delete chat"),
                                    :variant("destructive"),
                                    :on(click(on_delete))
                                )
                            )
                        ),
                        ui::alert(
                            :tone(info),
                            :text("This conversation is available on both the web and OpenTUI surfaces.")
                        ),
                        ui::chat(
                            :value($.prompt),
                            :session($.active_session),
                            :placeholder("Ask me anything…"),
                            :on(send(on_send))
                        )
                    )
                } else {
                    ui::empty(:text("Select a chat or create a new one."))
                }
            )
        )
    }

    method on_new() {
        ChatSessions.create(ChatSession.new(:title("Untitled")));
        ChatSessions.list();
        $.prompt = "";
        $.title_edit = "Untitled";
    }

    method on_select(ChatSession $session) {
        $.active_session = $session.id;
        $.title_edit = $session.title;
        $.prompt = "";
    }

    method on_rename() {
        ChatSessions.update(ChatSession.new(:id($.active_session), :title($.title_edit)));
        ChatSessions.list();
    }

    method on_delete() {
        ChatSessions.delete(ChatSession.new(:id($.active_session), :title($.title_edit)));
        ChatSessions.list();
        $.active_session = "";
        $.title_edit = "New conversation";
        $.prompt = "";
    }

    method on_send() {
        Assistant.complete();
    }
}

app ChatApp {
    route "/" => ChatPage;
}

processor Assistant {
    method complete(ChatRecord $record) {
        $record.prompt ==> llm::complete()
    }
}

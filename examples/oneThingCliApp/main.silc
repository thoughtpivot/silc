#!/usr/bin/env silc
# The one thing Dan should really do today, as a command.
# There is no web page and no terminal UI. `silc main.silc` reads the last
# week of ThoughtPivot's Moz company brain over MCP, briefs it with silclm,
# reduces it to one imperative sentence, prints that sentence, and exits.
# Every loop here is manual and there is no `app`, so the compiler builds a
# command instead of the /loops inbox. Each run is still recorded in the
# DailyActions table under .runtime/, so the history survives between runs.
# Needs MOZ_MCP_TOKEN in the environment (the Moz bearer token).
@version("0.5.0")

contract WindowArgs {
    has Str $.path;
    has Int $.tailRecords;
}

contract Brief {
    has Str $.facts;
    has Str $.goals;
    has Str $.pressure;
}

contract OneThing {
    has Str $.sentence;
}

contract DailyAction {
    has Str $.id;
    has Str $.day;
    has Str $.at;
    has Str $.sentence;
    has Str $.pressure;
}

resource DailyActions for DailyAction {
    query list;
    mutation create;
}

loop OneThingToday {
    loop::flow(
        loop::manual(),
        loop::read(
            :as(decisions),
            :op("mcp::call"),
            :server("https://moz-238959082585.us-central1.run.app/mcp"),
            :auth_env("MOZ_MCP_TOKEN"),
            :tool("kb_jsonl_read_window"),
            :args(WindowArgs.new(:path("memory/decisions.jsonl"), :tailRecords(6))),
            :select("records.parsed")
        ),
        loop::read(
            :as(meetings),
            :op("mcp::call"),
            :server("https://moz-238959082585.us-central1.run.app/mcp"),
            :auth_env("MOZ_MCP_TOKEN"),
            :tool("kb_jsonl_read_window"),
            :args(WindowArgs.new(:path("network/interactions.jsonl"), :tailRecords(6))),
            :select("records.parsed")
        ),
        loop::read(
            :as(projects),
            :op("mcp::call"),
            :server("https://moz-238959082585.us-central1.run.app/mcp"),
            :auth_env("MOZ_MCP_TOKEN"),
            :tool("kb_jsonl_read_window"),
            :args(WindowArgs.new(:path("operations/projects.jsonl"), :tailRecords(4))),
            :select("records.parsed")
        ),
        loop::read(
            :as(pipeline),
            :op("mcp::call"),
            :server("https://moz-238959082585.us-central1.run.app/mcp"),
            :auth_env("MOZ_MCP_TOKEN"),
            :tool("kb_jsonl_read_window"),
            :args(WindowArgs.new(:path("operations/opportunities.jsonl"), :tailRecords(4))),
            :select("records.parsed")
        ),
        loop::ask(
            :as(brief),
            :into(Brief),
            :from([$decisions.data, $meetings.data, $projects.data, $pipeline.data]),
            :retry(2),
            :prompt("You are gathering context for Dan Stephenson's single daily action at ThoughtPivot. Today is {$calendar.today} ({$calendar.weekday}). The reference data is four lists from the company brain: recent decisions, recent meetings, active projects, and open opportunities. Use only rows dated {$calendar.last7_start} through {$calendar.last7_end} for facts, and only goals that are still live through {$calendar.next7_end}. Drop anything older. facts: what happened in that window (decisions, meetings, open threads). goals: what Dan is driving through {$calendar.next7_end}. pressure: the one pressure that most determines today. Be compact."),
            loop::otherwise(loop::fail(:reason("could not brief the last 7 days")))
        ),
        loop::ask(
            :as(action),
            :into(OneThing),
            :from($brief),
            :retry(2),
            :prompt("Using only the brief, decide the single most important thing Dan must do today ({$calendar.today}) to serve the company goals. sentence: exactly one imperative sentence. No preamble, no lists, no reasons. If the brief is empty or outside the window, say in one sentence that the source window is unusable. Never invent facts."),
            loop::otherwise(loop::fail(:reason("could not decide today's one thing")))
        ),
        loop::gate(
            :that($action.sentence != "" && $brief.pressure != ""),
            :reason("Dan gets one grounded sentence or nothing"),
            loop::otherwise(loop::fail(:reason("the model returned an empty action")))
        ),
        loop::write(
            :to(DailyActions.create),
            :key("one-thing:{$now}"),
            :value(DailyAction.new(:day($calendar.today), :at($now), :sentence($action.sentence), :pressure($brief.pressure)))
        ),
        loop::notify(
            :to("Dan Stephenson"),
            :text("{$action.sentence}"),
            :key("one-thing:{$now}")
        )
    )
}

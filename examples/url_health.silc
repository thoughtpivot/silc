#!/usr/bin/env silc
# Probe URL → classify status text → record result
@version("1.0")

subset Uri of Str where { .contains("://") }

class HealthCheck {
    has Uri $.url;
    has Str $.body;
    has Str $.label;
}

class UrlProbe is service {
    method probe(Uri $url, :$timeout = 1500ms) {
        $url
            ==> http::get()
            ==> html::extract_body()
            ==> schema::bind(HealthCheck)
    }
}

class StatusClassifier is processor {
    method classify(HealthCheck $check) {
        $check.body
            ==> tensor::tokenize()
            ==> tensor::infer(:batch(1), :prefer<CPU>)
    }
}

class HealthStore is sink is latency(3ms) {
    method record(HealthCheck $check) {
        $check
            ==> store::upsert_primary()
    }
}

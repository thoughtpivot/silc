#!/usr/bin/env silc
# Seeded grocery inventory with deterministic filters, AI interpretation,
# visible-product-grounded chat, and a matching telnet terminal.
@version("1.0")

subset NonEmpty of Str where { .chars > 0 }

class InventoryTurn {
    has UUID $.id;
    has Str $.query;
    has NonEmpty $.prompt;
    has Str $.reply;
    has Str $.model;
}

class GroceryView is view {
    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("Grocery Inventory"))),
            ui::row(
                ui::stack(
                    ui::heading(:text("Fresh picks, clearly stocked"), :level(2)),
                    ui::text(:text("Type for instant deterministic filtering, or ask the local model to interpret a natural-language request.")),
                    ui::filter_bar(
                        ui::search_input(
                            :field(query),
                            :label("Find groceries"),
                            :placeholder("Try dairy, aisle 10, or snacks under $5")
                        )
                    ),
                    ui::product_grid(:empty_text("No groceries match the current filters."))
                ),
                ui::card(
                    ui::heading(:text("Ask about visible products"), :level(3)),
                    ui::text(:text("Answers are grounded only in the products shown on the left.")),
                    ui::chat(
                        :field(prompt),
                        :label("Inventory assistant"),
                        :placeholder("Which visible option has the most stock?")
                    )
                )
            )
        )
    }
}

class GroceryPortal is service {
    method listen(:$port = 18094) {
        InventoryTurn
            ==> ui::web(:view(GroceryView), :port(18094), :route("/"))
            ==> ui::terminal(:port(18024))
    }
}

class InventoryLlm is processor {
    has Str $.model_ref = "llama3.2-1b";

    method complete(InventoryTurn $turn) {
        $turn.prompt
            ==> llm::complete(:model($.model_ref))
    }
}

class InventoryDb is sink is storage(SQLite) {
    method persist(InventoryTurn $turn) {
        $turn
            ==> ipc::publish()
            ==> store::sqlite(:table(inventory_audit))
            ==> store::commit()
    }
}

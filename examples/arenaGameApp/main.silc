            ),
            game::entity(
                :name("Sun"),
                game::light(:kind(directional), :intensity(1.1), :color("#fff4e0"))
            )
        ),
        game::spawn(:prefab("Player"), :x(0), :y(1), :z(0), :as_pawn),
        game::mode(:id("arena"), :possess("Player")),
        game::controller(:scheme(wasd_mouse)),
        game::camera(:mode(first_person), :distance_m(5), :shoulder_offset_m(0.55), :follow(pawn)),
        game::signal(:name(ability_cast), :on("Mode.on_ability_cast")),
        game::post_process(:stage(bloom), :enabled(true)),
        game::post_process(:stage(tonemap), :enabled(true)),
        game::post_process(:stage(sharpen), :enabled(true)),
        game::overlay(:toggle("F1")),

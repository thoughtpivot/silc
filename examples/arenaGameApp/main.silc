        game::environment(:fog_density(0.012), :fog_color("#8aa0b8"), :sky_color("#6a84a8"), :exposure(1.1)),
        game::shadow(:enabled(true)),
        game::data(:name("VanguardData"), :damage(16), :fire_rate(9), :magazine(30), :reload(1.7), :spread(0.018)),
        game::data(:name("BreachData"), :damage(12), :fire_rate(1.2), :magazine(6), :reload(2.4), :spread(0.08), :pellet_count(10)),
        game::data(:name("ArcData"), :damage(28), :fire_rate(3.5), :magazine(18), :reload(2.0), :spread(0.01)),
        game::data(:name("RailData"), :damage(95), :fire_rate(0.7), :magazine(4), :reload(2.8), :spread(0.002)),
        game::weapon(:name("VanguardAR"), :slot(1), :fire_mode(hitscan), :ref("VanguardData")),

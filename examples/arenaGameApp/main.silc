#!/usr/bin/env silc
@version("0.4.0")

game Arena {
    game::scene(
        :title("MEGASTRUCTURE"),
        :renderer(webgpu),
        :target_fps(90),
        game::data(:name("WalkDefault"), :speed(5.5)),
        game::data(:name("BlastProfile"), :cooldown(0.8), :cost(10)),
        game::prefab(
            :name("Player"),
            game::mesh(:shape(capsule), :size(1.8), :color("#6ec8ff")),
            game::collider(:shape(capsule), :size(1.8)),
            game::movement(:style(first_person), :ref("WalkDefault")),
            game::attribute(:name("health"), :value(100), :max(100)),
            game::attribute(:name("stamina"), :value(100), :max(100)),
            game::pawn(),
            game::group(:name("player")),
            game::signal(:name(ability_cast)),
            game::ability(
                :name("Blast"),
                :key("1"),
                :ref("BlastProfile"),
                :cost_attr("stamina"),
                game::particle_emitter(:kind(burst), :count(96)),
                game::dynamic_light(:radius_m(5), :intensity(1.4), :color("#a8d4ff")),
                game::camera_impulse(:strength(0.2))
            ),
            game::ability(
                :name("Spark"),
                :key("2"),
                :cooldown(0.4),
                game::particle_emitter(:kind(spark), :count(48)),
                game::camera_impulse(:strength(0.1))
            )
        ),
        game::entity(
            :name("World"),

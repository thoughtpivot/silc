# Generated by Cargo
/target/
**/*.rs.bk

# IDE / OS
.idea/
.vscode/*
!.vscode/settings.json
*.swp
.DS_Store

# Per-program generated runtime (beside .silc/.raku entry files)
.runtime/

# Compiler-owned runtime lock/state (not project configuration)
.silc/

# Models (local artifacts)
*.onnx
!models/.gitkeep

# silclm training outputs (prompts, candidates, banks)
training/out/**
!training/out/.gitkeep

# Env / secrets
.env
.env.*

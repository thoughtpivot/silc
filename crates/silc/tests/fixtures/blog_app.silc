# Standalone blog app: chronological home, year/month filters, grounded silclm search,
# and admin CRUD with table-row modal edit. Thirty SilcLM-authored seeds ship with the app.
@version("0.4.0")

contract Article {
    has Str $.id;
    has Str $.title;
    has Str $.body;
    has Str $.author;
    has Str $.published_at;
    has Str $.year;
    has Str $.month;
}

contract ChatRecord {
    has Str $.prompt;
    has Str $.reply;
}


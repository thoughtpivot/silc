component ArticleCard {
    has Article $.article;

    method render() {
        ui::card(
            ui::heading(:text($.article.title), :level(3)),
            ui::badge(:text($.article.month), :tone(info)),
            ui::text(:text($.article.author)),
            ui::text(:text($.article.published_at)),
            ui::text(:text($.article.body))
        )
    }
}

component HomePage {
    has state Str $.year_filter = "All";
    has state Str $.month_filter = "All";
    has state Str $.prompt = "";
    query $.articles = Articles.list();

    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("Silc Blog"))),
            :side_panel(ui::side_panel(
                ui::nav_item(:label("Home"), :to("/"), :active),
                ui::nav_item(:label("Admin"), :to("/admin"))
            )),
            ui::stack(
                ui::section(
                    :title("Articles"),
                    :description("Browse chronologically, filter by year and month, or ask silclm about the live catalog.")
                ),
                ui::alert(
                    :tone(info),
                    :text("Home and Admin share the articles resource. Seeds load once with stable ids; admin edits persist across restarts.")
                ),
                ui::section(
                    :title("Filters"),
                    :description("Chip-style year and month filters narrow the card feed."),
                    ui::radio_group(
                        :field(year_filter),
                        :options(["All", "2024", "2025", "2026"]),
                        :label("Year")
                    ),
                    ui::radio_group(
                        :field(month_filter),
                        :options(["All", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]),
                        :label("Month")
                    )
                ),
                ui::section(
                    :title("Feed"),
                    :description("Newest articles first."),
                    when !$.articles {
                        ui::empty(:text("No articles yet."))
                    },
                    when $.year_filter == "All" {
                        when $.month_filter == "All" {
                            for $.articles -> $article {
                                ArticleCard(:article($article))
                            }
                        } else {
                            for $.articles -> $article {
                                when $article.month == $.month_filter {
                                    ArticleCard(:article($article))
                                }
                            }
                        }
                    } else {
                        when $.month_filter == "All" {
                            for $.articles -> $article {
                                when $article.year == $.year_filter {
                                    ArticleCard(:article($article))
                                }
                            }
                        } else {
                            for $.articles -> $article {
                                when $article.year == $.year_filter {
                                    when $article.month == $.month_filter {
                                        ArticleCard(:article($article))
                                    }
                                }
                            }
                        }
                    }
                ),
                ui::section(
                    :title("Ask about articles"),
                    :description("Natural-language search grounded on the live article snapshot."),
                    ui::chat(
                        :value($.prompt),
                        :context($.articles),
                        :persona("You are the Blog Assistant for this Silc blog app, built on silclm. Answer using the live article catalog: titles, authors, dates, and short bodies. Prefer concise citations."),
                        :placeholder("Which articles cover dual-surface UI?"),
                        :on(send(on_send))
                    )
                )
            )
        )
    }

    method on_send() {
        Assistant.complete();
    }
}

component AdminPage {
    has state Str $.title = "";
    has state Str $.body = "";
    has state Str $.author = "";
    has state Str $.published_at = "";
    has state Str $.year = "2026";
    has state Str $.month = "January";
    has state Str $.selected_id = "";
    has state Str $.edit_title = "";
    has state Str $.edit_body = "";
    has state Str $.edit_author = "";
    has state Str $.edit_published_at = "";
    has state Str $.edit_year = "2026";
    has state Str $.edit_month = "January";
    has state Bool $.dialog_open = false;
    query $.articles = Articles.list();

    method render() {
        ui::page(
            :app_bar(ui::app_bar(:title("Blog Admin"))),
            :side_panel(ui::side_panel(
                ui::nav_item(:label("Home"), :to("/")),
                ui::nav_item(:label("Admin"), :to("/admin"), :active)
            )),
            ui::stack(
                ui::section(
                    :title("New article"),
                    :description("Create a post. Year and month drive Home filters."),
                    ui::form(:on(submit(on_create)),
                        ui::text_input(:field(title), :label("Title")),
                        ui::textarea(:field(body), :label("Body")),
                        ui::text_input(:field(author), :label("Author")),
                        ui::text_input(:field(published_at), :label("Published at (YYYY-MM-DD)")),
                        ui::radio_group(
                            :field(year),
                            :options(["2024", "2025", "2026"]),
                            :label("Year")
                        ),
                        ui::select(
                            :field(month),
                            :options(["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]),
                            :label("Month")
                        ),
                        ui::toolbar(
                            ui::button(:label("Create"), :variant("primary"), :submit)
                        )
                    )
                ),
                ui::section(
                    :title("All articles"),
                    :description("Click a row to open the full article in a modal for edit or delete."),
                    ui::table(
                        :rows($.articles),
                        :columns(["title", "author", "published_at", "year", "month"]),
                        :empty_text("No articles yet."),
                        :sortable,
                        :searchable,
                        :selectable,
                        :on(select(on_select))
                    )
                ),
                ui::dialog(
                    :open($.dialog_open),
                    :title("Edit article"),
                    :on(confirm(on_save)),
                    :on(cancel(on_cancel)),
                    ui::stack(
                        ui::text_input(:field(edit_title), :label("Title")),
                        ui::textarea(:field(edit_body), :label("Body")),
                        ui::text_input(:field(edit_author), :label("Author")),
                        ui::text_input(:field(edit_published_at), :label("Published at")),
                        ui::radio_group(
                            :field(edit_year),
                            :options(["2024", "2025", "2026"]),
                            :label("Year")
                        ),
                        ui::select(
                            :field(edit_month),
                            :options(["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]),
                            :label("Month")
                        ),
                        ui::toolbar(
                            ui::button(
                                :label("Delete"),
                                :variant("destructive"),
                                :on(click(on_delete))
                            )
                        )
                    )
                )
            )
        )
    }

    method on_create() {
        Articles.create(Article.new(
            :title($.title),
            :body($.body),
            :author($.author),
            :published_at($.published_at),
            :year($.year),
            :month($.month)
        ));
        Articles.list();
        $.title = "";
        $.body = "";
        $.author = "";
        $.published_at = "";
        $.year = "2026";
        $.month = "January";
    }

    method on_select(Article $article) {
        $.selected_id = $article.id;
        $.edit_title = $article.title;
        $.edit_body = $article.body;
        $.edit_author = $article.author;
        $.edit_published_at = $article.published_at;
        $.edit_year = $article.year;
        $.edit_month = $article.month;
        $.dialog_open = true;
    }

    method on_save() {
        Articles.update(Article.new(
            :id($.selected_id),
            :title($.edit_title),
            :body($.edit_body),
            :author($.edit_author),
            :published_at($.edit_published_at),
            :year($.edit_year),
            :month($.edit_month)
        ));
        Articles.list();
        $.dialog_open = false;
        $.selected_id = "";
    }

    method on_delete() {
        Articles.delete(Article.new(
            :id($.selected_id),
            :title($.edit_title),
            :body($.edit_body),
            :author($.edit_author),
            :published_at($.edit_published_at),
            :year($.edit_year),
            :month($.edit_month)
        ));
        Articles.list();
        $.dialog_open = false;
        $.selected_id = "";
    }

    method on_cancel() {
        $.dialog_open = false;
        $.selected_id = "";
    }
}

app BlogApp {
    route "/" => HomePage;
    route "/admin" => AdminPage;
}

processor Assistant {
    method complete(ChatRecord $record) {
        $record.prompt ==> llm::complete()
    }
}

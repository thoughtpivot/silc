#!/usr/bin/env silc
# UpstreamWatch, the silc.thoughtpivot.com loop example (THO-551). Everything
# from `contract Release` down is the site's copy; the declarations above it
# are the minimum the site's loop assumes.
@version("0.8")

subset Emb384 of Vec[num32; 384];

contract Dependency {
    has Str $.id;
    has Str $.name;
    has Str $.changelog;
}

contract Incident {
    has Str $.id;
    has Str $.summary;
    has Emb384 $.vector_embedding;
}

contract Ticket {
    has Str $.id;
    has Str $.title;
    has Str $.risk;
}

resource Dependencies for Dependency {
    query list;
    mutation create;
}

resource Incidents for Incident {
    query list;
    query nearest;
    mutation create;
}

resource Tickets for Ticket {
    query list;
    mutation create;
}

contract Release { has Str $.version; has Str $.text; }
contract Impact  { has Str $.risk; has Str $.summary; }

loop UpstreamWatch {
  loop::flow(
    loop::schedule(:cron("0 7 * * 1-5"), :tz("America/Chicago")),
    loop::find(:as(deps), :from(Dependencies.list), :max(40)),

    loop::each(:in($deps), :as(dep), :max(40),
      loop::read(:as(release), :into(Release),
        scrape::page(:url($dep.changelog), :select("article"),
          :fields(Release.new(:version("h2"))))),

      loop::let(:as(vec),
        tensor::infer(:model("minilm-l6-v2"), :from($release.text))),
      loop::find(:as(seen), :max(5),
        :from(Incidents.nearest(:to($vec)))),

      loop::ask(:as(impact), :into(Impact), :retry(2),
        :from($release, $seen),
        :prompt("Does {$dep.name} {$release.version} repeat any of these?"),
        loop::otherwise(loop::skip(:reason("no answer that fits Impact")))),

      loop::gate(:that($impact.risk != "none"),
        :reason("only real risk reaches a person"),
        loop::otherwise(loop::skip(:reason("no risk")))),

      loop::write(:to(Tickets.create),
        :key("upgrade:{$dep.name}:{$release.version}"),
        :value(Ticket.new(:title($impact.summary),
          :risk($impact.risk))))
    ),

    loop::notify(:to("platform"), :text("Watch ran {$calendar.today}"),
      :key("watch:{$calendar.today}"))
  )
}

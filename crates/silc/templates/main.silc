#!/usr/bin/env silc
# Starter Silc program — edit this file; do not edit .runtime/
@version("1.0")

subset Uri of Str where { .contains("://") }

class Payload {
    has Uri $.url;
    has Str $.body;
    has Str $.label;
}

class Ingress is service {
    method fetch(Uri $url, :$timeout = 1500ms) {
        $url
            ==> http::get()
            ==> html::extract_body()
            ==> schema::bind(Payload)
    }
}

class Analyzer is processor {
    method classify(Payload $payload) {
        $payload.body
            ==> tensor::tokenize()
            ==> tensor::infer(:batch(1), :prefer<CPU>)
    }
}

class Store is sink is latency(5ms) {
    method persist(Payload $payload) {
        $payload
            ==> store::upsert_primary()
    }
}
